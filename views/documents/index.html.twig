{% extends "base.html.twig" %}

{% block content %}

    <!-- Toolbar -->
    <div class="container bg-light text-dark p-3 mb-3 rounded-3 px-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0">Document Management</h1>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadFileModal">Upload File</button>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#uploadFolderModal">New Folder</button>
            </div>
        </div>
    </div>

    <!-- File Browser -->
    <div class="container mx-0 px-0">
        <div class="bg-dark text-white rounded-3 p-3 shadow-sm" style="width: 40%; min-width: 320px;">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h5 mb-1">Files &amp; Folders</h2>
                    <small class="text-white-50">Your documents</small>
                </div>

                <button type="button" class="btn btn-sm btn-outline-light" onclick="window.location.reload()">Refresh</button>
            </div>

            <!-- File list -->
            <div class="bg-secondary bg-opacity-25 rounded-3 overflow-hidden">

                {% for document in documents.items %}

                    <div class="d-flex align-items-center justify-content-between px-3 py-3 border-bottom border-secondary file-item">

                        <div class="text-truncate" style="min-width: 0;">
                            <div class="text-truncate" title="{{ document.file.name }}">{{ document.file.name }}</div>
                            <small class="text-white-50">{{ document.mime_type }}</small>
                        </div>

                        <div class="dropdown ms-2">
                            <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">More</button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Open</a></li>
                                <li><a class="dropdown-item" href="#">Download</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="#">Delete</a></li>
                            </ul>
                        </div>

                    </div>

                {% else %}

                    <div class="text-center text-white-50 py-5">
                        <div class="fw-semibold mb-1">No files found</div>
                        <small>Upload a file to get started.</small>
                    </div>

                {% endfor %}

            </div>

            <!-- Pagination information -->
            {% if documents.pages > 1 %}
            <nav aria-label="File navigation" class="mt-3">
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                
                    {% if documents.page > 1 %}
                        <li class="page-item"><a class="page-link" href="?page={{ documents.page - 1 }}">Previous</a></li>
                    {% else %}
                        <li class="page-item disabled"><span class="page-link">Previous</span></li>
                    {% endif %}
                
                    {% for page in 1..documents.pages %}
                        {% if page == documents.page %}
                            <li class="page-item active" aria-current="page"><span class="page-link">{{ page }}</span></li>
                        {% else %}
                            <li class="page-item"><a class="page-link" href="?page={{ page }}">{{ page }}</a></li>
                        {% endif %}
                    {% endfor %}
                
                    {% if documents.page < documents.pages %}
                        <li class="page-item"><a class="page-link" href="?page={{ documents.page + 1 }}">Next</a></li>
                    {% else %}
                        <li class="page-item disabled"><span class="page-link">Next</span></li>
                    {% endif %}
                
                </ul>
            </nav>
            {% endif %}

        </div>
    </div>

    <!-- Upload File Modal -->
    <div class="modal fade" id="uploadFileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <form action="/document/save" method="POST" enctype="multipart/form-data">

                    <div class="modal-header">
                        <h5 class="modal-title">Upload File</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <label for="file" class="form-label">Select a file</label>
                        <input type="file" id="file" name="file" class="form-control" required>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </div>

                    {% if parent_id is defined and parent_id %}
                        <input type="hidden" value="{{ parent_id }}">
                    {% endif %}
                </form>

            </div>
        </div>
    </div>

    <!-- New Folder Modal -->
    <div class="modal fade" id="uploadFolderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <form action="/directory/save" method="POST">

                    <div class="modal-header">
                        <h5 class="modal-title">Create Folder</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <label for="directory" class="form-label">Folder name</label>
                        <input type="text" id="directory" name="directory" class="form-control" required placeholder="Folder Name">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Folder</button>
                    </div>

                    {% if parent_id is defined and parent_id %}
                        <input type="hidden" value="{{ parent_id }}">
                    {% endif %}

                </form>

            </div>
        </div>
    </div>

{% endblock %}

