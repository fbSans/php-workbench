{% extends "base.html.twig" %}
{% block content %} 
    
    <div class="container bg-dark text-white p-2 mb-1 rounded-3  px-4">
        <span class="title">Toolbar</span>
        <ul class="list-unstyled d-flex gap-2">
            <li>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadFileModal">
                    New File
                </button>
            </li>
            <li>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadFolderModal">
                    New Folder
                </button>
            </li>
        </ul>
    </div>

    <div class="container justfily-content-start mx-0 px-0">
        <div class="bg-dark text-white rounded-3 px-2  py-2 mx-0" style="width: 40%;min-width:20px;">
            <h2>Files &amp; Folders</h2>
            <div class="bg-light">
                {% for document in documents %}
                    <span> {{ document.name }}</span>
                {% else %} 
                    <span class="bg-light text-dark text-muted"> No files found. </span>    
                {% endfor %}
            </div>
        </div>

        <div class="modal fade" id="uploadFileModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/document/save" method="POST" enctype="multipart/form-data">
                        <div class="modal-header">
                            <h5 class="modal-title">Upload File</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <input type="file" name="file" class="form-control" required>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-primary">
                                Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="uploadFolderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/directory/save" method="POST">
                        <div class="modal-header">
                            <h5 class="modal-title">Create Folder</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <input type="text" name="directory" class="form-control" required placeholder="Folder Name">
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-primary">
                                Save
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

