<!DOCTYPE html>
<html lang="en">
<head>
    {% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Document Management System</title>

    <link rel="stylesheet" href="/assets/bootstrap/css/bootstrap.min.css">
    {% endblock %}
</head>

<body class="bg-dark">

<nav class="navbar navbar-dark bg-black">
    <div class="container">
        {% block navigation %}
        <ul class="list-unstyled d-flex justify-content-end">
            <li>
                <a class="navbar-brand" href="/">
                    Home
                </a>
            </li>
            <li>
                <a class="navbar-brand" href="/documents">
                    Documents
                </a>
            </li>
            <li>
                <a class="navbar-brand" href="/profile">
                    Profile
                </a>
            </li>
        </ul>
        <div class="d-flex">
            <form action="/logout" method="post">
                <button type="submit" class="btn btn-warning">Logout</button>   
            </form>
        </div>
        {% endblock %}
    </div>
</nav>

<main class="container py-5">
    {% block content %}{% endblock %}
</main>

<script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>

{% if error_message is defined and error_message %}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div
            id="errorToast"
            class="toast text-bg-danger"
            role="alert"
            aria-live="assertive"
            aria-atomic="true"
        >
            <div class="toast-header">
                <strong class="me-auto">Error</strong>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                    aria-label="Close"
                ></button>
            </div>

            <div class="toast-body">
                {{ error_message }}
            </div>
        </div>
    </div>

    <script>
        const toastEl = document.getElementById('errorToast');
        const toast = new bootstrap.Toast(toastEl, {
            delay: 3000
        });

        toast.show();
    </script>
{% endif %}

{% if success_message is defined and success_message %}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div
            id="successToast"
            class="toast text-bg-success"
            role="alert"
            aria-live="assertive"
            aria-atomic="true"
        >
            <div class="toast-header">
                <strong class="me-auto">Message</strong>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                    aria-label="Close"
                ></button>
            </div>

            <div class="toast-body">
                {{ success_message }}
            </div>
        </div>
    </div>

    <script>
        const toastEl2 = document.getElementById('successToast');
        const toast2 = new bootstrap.Toast(toastEl2, {
            delay: 3000
        });

        toast2.show();
    </script>
{% endif %}

</body>
</html>