{
    "name": "dms/dms_lean",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Base\\": "bases/",    
            "Documents\\": "modules/documents/",
            "Users\\": "modules/users/",
            "Helpers\\": "helpers/",
            "Routes\\": "routes/",
            "Configs\\": "configs/",    
            "Init\\":  "init/",
            "Middleware\\": "middlewares"    
        },
        "files": [
            "helpers/helpers.php",
            "configs/config.php",
            "configs/middleware.php",
            "init/app.php"
        ]
    },
    "require": {
        "php": "^8.2",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    }
